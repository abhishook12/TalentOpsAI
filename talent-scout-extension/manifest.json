{
  "manifest_version": 3,
  "name": "TalentOps Talent Scout",
  "version": "3.0.0",
  "description": "Visual-First & DOM Autonomous Scraping Engine for TalentOpsAI. Observes live screen changes, extracts verified recruiter leads, and enriches candidate pipelines 24/7.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TalentOps Talent Scout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "detector/patterns.js",
        "detector/linkedin.js",
        "detector/email.js",
        "detector/indeed.js",
        "detector/glassdoor.js",
        "detector/ziprecruiter.js",
        "detector/generic.js",
        "visual/diff.js",
        "visual/store.js",
        "visual/engine.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["config.json", "icons/*", "visual/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
